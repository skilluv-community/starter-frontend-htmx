---
import Base from '../layouts/Base.astro';
---

<Base title="HTMX demo — Skilluv starter">
  <h1 class="text-2xl font-bold mb-2">Interactive (HTMX)</h1>
  <p class="text-slate-400 mb-6">
    Type in the box below. Each keystroke posts to <code>/api/search</code> and swaps the results fragment.
  </p>

  <div class="rounded border border-slate-800 p-6 space-y-4">
    <input
      type="text"
      name="q"
      placeholder="Search fruits…"
      class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2"
      hx-post="/api/search"
      hx-trigger="input changed delay:200ms, load"
      hx-target="#results"
    />
    <ul id="results" class="space-y-1 text-sm"></ul>
  </div>
</Base>
