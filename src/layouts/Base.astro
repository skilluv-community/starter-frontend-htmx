---
interface Props {
  title?: string;
}
const { title = 'Skilluv starter — HTMX' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" defer></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.9/dist/cdn.min.js"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased">
    <header class="border-b border-slate-800 px-6 py-4 flex items-center justify-between">
      <a href="/" class="font-bold text-lg">Skilluv · HTMX</a>
      <nav class="flex gap-4 items-center text-sm">
        <a href="/" class="hover:underline">home</a>
        <a href="/interactive" class="hover:underline">interactive</a>
        <a href="/counter" class="hover:underline">counter</a>
      </nav>
    </header>
    <main class="p-6 max-w-3xl mx-auto">
      <slot />
    </main>
    <footer class="mt-16 px-6 py-4 text-xs text-slate-500 border-t border-slate-800">
      MIT · <a href="https://skilluv.io" class="underline">skilluv.io</a>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles.css';
</style>
